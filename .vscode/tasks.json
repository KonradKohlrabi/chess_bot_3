{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "process",
            "command": "C:\\raylib\\w64devkit\\bin\\g++.exe",
            "args": [
                "-O2",
                "-std=c++17",
                "main.cpp",
                "-o",
                "chess.exe",
                "-g",
                "-I",
                "C:\\raylib\\raylib\\src",
                "-L",
                "C:\\raylib\\raylib\\src",
                "-lraylib",
                "-lopengl32",
                "-lgdi32",
                "-lwinmm"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Run",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-Command",
                "& '${workspaceFolder}\\chess.exe'"
            ],
            "dependsOn": "Build",
            "dependsOrder": "sequence",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}